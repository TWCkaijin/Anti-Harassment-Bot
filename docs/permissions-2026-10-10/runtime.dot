digraph Runtime {
 graph [rankdir=LR,bgcolor="#f8fafc",pad="0.3",nodesep="0.4",ranksep="0.7",fontname="Arial",label="Runtime access: configured identities and legacy exception",labelloc=t,fontsize=22];
 node [shape=box,style="rounded,filled",fillcolor="white",color="#94a3b8",fontname="Arial",fontsize=12];
 edge [fontname="Arial",fontsize=10,color="#64748b"];
 browser [label="Public HTTPS ingress\nallUsers Run Invoker",fillcolor="#dbeafe"];
 admin [label="Admin application gate\nSession + Origin + CSRF\nInternal routes: verified OIDC",fillcolor="#dbeafe"];
 devclient [label="api_preview\nrag-client-dev",fillcolor="#dcfce7"];
 devadmin [label="admin_api_preview\nrag-admin-dev",fillcolor="#dcfce7"];
 prodadmin [label="admin_api\nrag-admin-prod",fillcolor="#dcfce7"];
 legacy [label="api (production Client)\nDefault Compute account\nPROJECT EDITOR",fillcolor="#fee2e2"];
 ready [label="rag-client-prod\nConfigured but not current api runtime",style="rounded,dashed",fillcolor="white"];
 appdev [label="app-dev"];privdev [label="admin-private-dev"];
 appprod [label="(default)"];privprod [label="admin-private"];
 devres [label="DEV secrets: payload access\nDEV admin bucket: objectAdmin\nDEV task queue: enqueuer"];
 prodres [label="PROD secrets: payload access\nPROD admin bucket: objectAdmin\nPROD task queue: enqueuer"];
 task [label="rag-tasks-dev / prod\nOIDC identity only\nNo direct database grant"];
 browser->devclient;browser->legacy;browser->admin;
 admin->devadmin;admin->prodadmin;
 devclient->appdev [label="read"];
 devadmin->appdev [label="read/write"];devadmin->privdev [label="read/write"];devadmin->devres;
 prodadmin->appprod [label="read/write"];prodadmin->privprod [label="read/write"];prodadmin->prodres;
 ready->appprod [label="read",style=dashed];
 legacy->appdev [label="broad project access",color="#dc2626"];legacy->appprod [color="#dc2626"];legacy->privdev [color="#dc2626"];legacy->privprod [color="#dc2626"];
 devadmin->task [label="actAs: dev only"];prodadmin->task [label="actAs: prod only"];
 task->admin [label="Tasks / Scheduler signed OIDC",style=dashed];
}
