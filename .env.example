# 性騷擾防治智能 AI — 環境變數範本
# 複製此檔案為 .env 並填入實際值
# 警告：.env 已加入 .gitignore，請勿將真實金鑰提交至版本控制

# ── OpenRouter API ───────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_TOP_P=1.0
# 設為 0 時，不向 OpenRouter 傳送 max_tokens（由模型自行決定上限）。
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_REQUEST_TIMEOUT_SECONDS=60
# Runtime 設定由 Firestore runtime_config 優先控制；下列值只在文件不存在或欄位未設定時作為本地 fallback。

# ── Embedding ──────────────────────────────────────────────────────────
# openrouter: 使用 OpenRouter embeddings endpoint
# local: 使用本機 sentence-transformers（需自行安裝模型依賴）
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# ── RAG / Firestore Vector Search ───────────────────────────────────────
RAG_COLLECTION_NAME=rag_documents
RAG_JUDGMENT_COLLECTION_NAME=rag_judgments
RAG_REMEDY_COLLECTION_NAME=rag_remedies
RAG_RETRIEVAL_TOP_K=3

# ── Firebase ───────────────────────────────────────────────────────────
# Firebase Admin SDK JSON 路徑（預設為專案根目錄的 firebase_admin.json）
# FIREBASE_ADMIN_CREDENTIAL_PATH=./firebase_admin.json

# ── Runtime Admin / Firestore Runtime Config ────────────────────────────
# Admin panel 呼叫 /v1/admin/config 時使用；請用高強度隨機字串，並放在 secret。
ADMIN_API_KEY=change_me_to_a_long_random_admin_token
RUNTIME_CONFIG_COLLECTION_NAME=runtime_config
RUNTIME_CONFIG_DOCUMENT_ID=app_dev
RUNTIME_CONFIG_CACHE_TTL_SECONDS=30
# dev / main 使用不同的 Firestore document，例如 app_dev / app_main。

# ── Flask API ──────────────────────────────────────────────────────────
API_TITLE=性騷擾防治智能 AI API
API_VERSION=0.1.0
# CORS_ORIGINS 必須是完整的 HTTP(S) origin JSON 陣列，不接受 wildcard。
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://anti-harassment-bot.web.app","https://anti-harassment-bot.firebaseapp.com"]
# Firebase preview URL 含隨機 hash；只接受完整錨定的安全 pattern。JSON 內的反斜線需要轉義。
CORS_PREVIEW_ORIGIN_REGEXES=["\\Ahttps://anti-harassment-bot--dev-preview-[a-z0-9-]+\\.web\\.app\\Z"]
# 單一 HTTP request body 上限（預設 8 MiB）。
API_MAX_CONTENT_LENGTH_BYTES=8388608
# 前端開始附帶 X-Firebase-AppCheck 後才能改為 true。
CHAT_APP_CHECK_ENABLED=false
# 此限流僅限單一 process/instance，正式環境仍需全域配額與預算保護。
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Privacy ────────────────────────────────────────────────────────────
ENABLE_ANONYMIZATION=true

# ── 執行環境（development / production / preview）──────────────────────
ENVIRONMENT=development
