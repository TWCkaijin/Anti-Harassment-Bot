# Single source of the Google Cloud / Firebase project this repository deploys to.
# Hosting sites, the Admin bucket and service-account emails are derived from it
# (see shared/python/rag_core/core/project.py). The environment variable
# FIREBASE_PROJECT_ID overrides this file.
# After changing it, run: uv run --frozen python scripts/sync_project_config.py --write
FIREBASE_PROJECT_ID=anti-harassment-bot
