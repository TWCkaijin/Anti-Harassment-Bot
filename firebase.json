{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": ".",
      "codebase": "api",
      "runtime": "python313",
      "ignore": [
        ".git",
        ".github",
        ".venv",
        "venv",
        "node_modules",
        "frontend",
        "tests",
        "docs",
        "data",
        "resource",
        "scripts",
        ".firebase",
        ".pnpm-store",
        ".code-review-graph",
        ".pytest_cache",
        ".ruff_cache",
        ".mypy_cache",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/*.pyo",
        "**/.DS_Store",
        ".DS_Store",
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*",
        "firebase_admin.json",
        "**/firebase_admin*.json",
        "**/*.pem",
        "**/*.key",
        "*.log",
        "**/*.log",
        "build",
        "dist",
        "wheels",
        "**/*.egg-info/**",
        "Agent.md",
        "TODO.md",
        "implementation.md",
        "lint.sh",
        "README.md"
      ]
    }
  ]
}
